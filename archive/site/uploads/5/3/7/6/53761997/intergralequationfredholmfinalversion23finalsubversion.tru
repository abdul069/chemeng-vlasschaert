print "******************************************"
print "* integral equations ,version 2.3  'sub' *"
print "* peter.vlasschaert@gmail.com,09/01/2018 *"
print "******************************************"
print "******************************************"
print "* form :fredholm,second kind             *"
print "******************************************"
print " phi(x)+int(ker(x,t)*phi(t),t,aa,bb) =f(x)"
print "******************************************"
print "---------------------------------"
print " example : f(x)     = exp(x)     "
print " example : ker(x,t) = x*exp(x*t) " 
print "---------------------------------"
!*****************************************************************************
! three methods :simpson,trapezodial,gauss-legendre quadrature.(same problem)*
! see website : special topics 2018:special functions.                       *
!*****************************************************************************
option nolet
!*****************************************************************************
!* rem : phi(x)+ int(ker(x,t)*phi(t),t,aa,bb) = f(x)                         *
!*****************************************************************************
! int = integration 
! ker = kernel of the integral equation
! filename :intergralequationfredholmfinalversion23finalsubversion.tru
!*********************************************************************
!***********************************************************
! declare the used functions
!***********************************************************
declare function ker,f
!***********************************************************
! use simpson's formula nn=n=2,code only for nn=2
!***********************************************************
!************************************************
! 0e) input : values
!************************************************
input prompt "'simpson method =1,trapezodial method =2', gauss method = 3' => ":s
print
aa=0         !  begin value : integration
bb=1         !  end   value : integration
nn = 2       !  number of intervals;code only for nn=2
print " number of intervals        'nn' = ";nn
print " begin interval integration 'aa' = ";aa
print " end   interval integration 'bb' = ";bb
delta = bb-aa
if s=1 then
!*simpson method*****
   m = nn/2
   h = delta /(2*m)
else if s=2 then
!*trapezoidal method*
   h = delta/nn
else
corr = (bb-aa)/2
end if
if s=1 or s=2 then
   print " step value                 'h' = ";h
end if
print
dim a(0:1)
mat redim a(0:nn)
!************************************************
!1e)simpson's rule (example nn=2)
!************************************************
if s=1 then
call simpson_int(nn,h,a())
   else if s=2 then
call trapezoidal_int(nn,h,a())
   else
a(0)=5/9
a(1)=8/9
a(2)=5/9
end if
print " a(i), i=0..";nn;" => "
mat print a
!b) tj => tj(i) ,i=0..nn
! values to evaluate,phi(x)
dim tj(0:1)
mat redim tj(0:nn)
call eval_phi(s,aa,bb,nn,h,tj())
print " t i , i=0..";nn;" => "
mat print tj
!************************************************
!2e)hulp matrix 'k' for mat kk => 
!************************************************
dim kk(1,1),k(1,1)
mat redim kk(nn+1,nn+1),k(nn+1,nn+1)
call hulp_matrix(corr,s,nn,a(),k(,),tj())
print " hulp matrix 'k' for mat kk => "
mat print k
!************************************************
! 3e) build kk: from integral equation above
!************************************************
!a) build unit matrix
dim id(1,1)
mat redim id(nn+1,nn+1)
call kk_matrix(id(,),k(,),kk(,))
mat print kk
!*************************************************
!4e) right hand side (rhs 'vector') of matrix kk
!*************************************************
print " right hand side matrix 'kk' = mat rhs => "
dim rhs(1,1)
mat redim rhs(nn+1,1)
call rhs_eq(s,nn,rhs(,),tj())
mat print rhs
print
!************************************************
!5e) solution,phi
!************************************************
dim phi(1,1)
mat redim phi(nn+1,1)
!a) invers matrix kk (exit = non singular)
print " inverse matrix 'kk' = mat k_inv => "
dim k_inv(1,1)
mat redim k_inv(nn+1,nn+1)
mat k_inv = inv(kk)
mat print k_inv
!b) find phi vector
print "-----------------------"
print " result : phi 'vector' "
print "-----------------------"
mat phi = k_inv*rhs
for i=0 to nn
 print "t";i;" = ";tj(i)," => ";i+1;"e) row phi = ";phi(i+1,1)
next i
print
!c) example
!************************************************
!6e) output : phi(x) ,approximation
!************************************************
if s=1 then
print " delta = delta/6 "
m$  = " xx    = "
m1$ = " ker(x,t"& str$(0)& ")*"
m2$ = " +4*ker(x,t"& str$(1) & ")*"
m3$ = " + ker(x,t"& str$(2) & ")*"
! rem :value to string => val to str$(val)
print m$ & m1$;phi(1,1);m2$;phi(2,1);m3$;phi(nn+1,1)
  else if s=2 then
! ?????????????????????????????????
print " delta = delta/4 "
m$  = " xx    = "
m1$ = " ker(x,t"& str$(0)& ")*"
m2$ = " +2*ker(x,t"& str$(1) & ")*"
m3$ = " + ker(x,t"& str$(2) & ")*"
! rem :value to string => val to str$(val)
print m$ & m1$;phi(1,1);m2$;phi(2,1);m3$;phi(nn+1,1)
  else
! delta : correction for interval:(aa,bb)->(-1,1)
! ?????????????????????????????????
print " delta = 1,(see corr =(bb-aa)/2)"
m$  = " xx    = "
m1$ = "5/9* ker(x,t"& str$(0)& ")*"
m2$ = " +8/9*ker(x,t"& str$(1) & ")*"
m3$ = " +5/9*ker(x,t"& str$(2) & ")*"
! rem :value to string => val to str$(val)
print m$ & m1$;phi(1,1);m2$;phi(2,1);m3$;phi(nn+1,1)
end if
print
print "--------------------------------"
print " result approximation phi(x) => "
print "--------------------------------"
print " phi(x) = f(x) - delta*xx "
end


!******************** sub   *******************

sub hulp_matrix(corr,s,nn,a(),k(,),tj())
declare function ker,f
for i=1 to nn+1
    for j=1 to nn+1
 if j=i then
   if s=1 or s=2 then
      k(i,j) = -a(i-1)*ker(tj(i-1),tj(i-1))
   else
    ! change integration interval:(aa,bb)->(-1,1)  
      k(i,j) = -corr*a(i-1)*ker(tj(i-1),tj(i-1)) 
   end if
 else
  if s=1 or s=2 then
     k(i,j) = -a(j-1)*ker(tj(i-1),tj(j-1))
  else
    ! change integration interval:(aa,bb)->(-1,1)
     k(i,j) =-corr*a(j-1)*ker(tj(i-1),tj(j-1))
  end if
 end if
    next j
next i
end sub

sub kk_matrix(id(,),k(,),kk(,))
mat id=idn
print " result = mat kk           => "
!b) result kk matrix
mat kk = k-id
end sub

sub rhs_eq(s,nn,rhs(,),tj())
declare function ker,f
for i=1 to nn+1
 rhs(i,1)=-f(tj(i-1))
next i
end sub

sub eval_phi(s,aa,bb,nn,h,tj())
if s=1 or s=2 then
for i=0 to nn
 tj(i)= aa + i*h
next i
 else
delta = bb-aa
!**********************************
!**********************************
! t=(bb-aa)/2*xi+(aa+bb)/2
! xi ,i=0,1,nn => roots: P[nn+1](x)
!**********************************
! nn = 2 i=0,1,2
!x0=-sqr(3/5),x1=0,x2=+sqr(3/5)
!**********************************
!**********************************
tj(0)  = -sqr(3/5)*delta/2 +(aa+bb)/2
tj(1)  = 0*delta/2+(aa+bb)/2
tj(nn) = +sqr(3/5)*delta/2 +(aa+bb)/2
end if
end sub

sub simpson_int(nn,h,a())
! a) simpson 
a(0) = h/3   ! first value
a(nn)= h/3   ! last  value
for i=1 to nn-1
 if mod(i,2) = 0 then
  ! even: coef.
  a(i) = 2*h/3
 else 
  ! odd: coef.
  a(i) = 4*h/3
 end if
next i
end sub

sub trapezoidal_int(nn,h,a())
a(0) = h/2   ! first value
a(nn)= h/2   ! last  value
for i=1 to nn-1
   a(i) = h
next i
end sub
!******************** function *******************

function ker(x,t)
! other example
!tel = 1+x+t
!num = 2+x^2+t^2
!ratio = tel/num
ratio = x*exp(x*t)
ker=ratio
end function

function f(x)
! other example
!f=exp(-x)
f=exp(x)
end function


