option nolet
print "******************************************"
print "* boundaries,domain fill ,version 1.0    *"
print "* peter.vlasschaert@gmail.com,23/12/2017 *"
print "******************************************"
print "******************************************"
print "* reactangular domain : fill             *"
print "******************************************"
print
print "**************"
print "*=> matrix b *"
print "**************"
print
dim a(1,1),b(1,1)
nx = 8   ! number of rows
ny = 8   ! number of columns
mat redim a(nx,ny)
mat redim b(nx,ny)
!rem: use else if construct (program)
for j=1 to nx
    for i=1 to ny
   if i=1 then
         if j=1 then 
            a(1,1)= 2 ! top left corner
            print " top left corner     = ";a(1,1)
         else if j=ny then 
            a(1,ny)=1 ! bottom left corner
            print " bottom left corner  = ";a(1,ny)
         else
            a(i,j) =6 !left side
         end if
   else if i=nx  then
          if j=1 then
            a(nx,1)= 3 !top right corner
            print " top right corner    = ";a(nx,1)
          else if j=ny then
            a(nx,ny)=4 !bottom right corner
            print " bottom right corner = ";a(nx,ny)
          else
            a(i,j)=8 !right side
          end if
   else if j=1 then
            a(i,j)= 7!bottom side
   else if j=ny then
            a(i,j)= 5!top side
   else 
           a(i,j)= 9 !body (inside domain)
   end if
  next i
next j
print
print "*************"
print "*matrix a =>*"
print "*************"
print
mat print a 
print
mat b=trn(a) ! transpose of matrix a
print "****************************"
print "****************************"
print "*result = domain (matrix b)*"
print "****************************"
print "****************************"
print
print "left   side = ";6
print "right  side = ";8
print "bottom side = ";5
print "top    side = ";7
print
print "********************"
print " inside domain = ";9
print "********************"
print
mat print b 
end


