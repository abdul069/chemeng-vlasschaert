option nolet
print "******************************************"
print "*integral equations ,version 1.2         *"
print "* peter.vlasschaert@gmail.com,31/12/2017 *"
print "******************************************"
print "******************************************"
print "* form :fredholm second kind             *"
print "******************************************"
print " phi(x)+int(ker(x,t)*phi(t),t,a,b) =f(x) *"
print "******************************************"
print "---------------------------------"
print " example : f(x)     = exp(x)     "
print " example : ker(x,t) = x*exp(x*t) " 
print "---------------------------------"
!*****************************************************
! rem : phi(x)+ int(ker(x,t)*phi(t),t,a,b) = f(x)
!*****************************************************
! int = integration 
! ker = kernel
! filename :intergralequationfredholmfinalversion12.tru
!*****************************************************
!***************************
! declare the used functions
!***************************
declare function ker,f
!*****************************
! use simpson's formula nn=n=2
!*****************************
a=0
b=1
print " begin interval integration 'a' = ";a
print " end   interval integration 'b' = ";b
delta = b-a
print " delta = ";b;" - ";a;" = "; b-a
! =>  nn=2 
nn = 2       ! number of intervals;
h= delta/nn  ! step value;
print " number of intervals 'nn' = ";nn
print " step value          'h ' = ";h
!*******************************************
t0=a
t1=a+b/nn
t2=a+b
!*******************************************
print " points t0,t1,t2 => "
print "t0 = ";t0
print "t1 = ";t1
print "t2 = ";t2
! use phi(x),phi(t) => numerical : matrix kk
! 1e) initial matrix kk ,need hulp matrix k
dim kk(1,1),k(1,1)
mat redim kk(nn+1,nn+1),k(nn+1,nn+1)
print " initial dimension matrix ' integral eq. above => "
mat print kk
! 2e) build hulp matrix k
delta = -h/3
k(1,1) = delta*ker(t0,t0)
k(1,2) = delta*4*ker(t0,t1)
k(1,3) = delta*ker(t0,t2)
k(2,1) = delta*ker(t1,t0)
k(2,2) = delta*4*ker(t1,t1)
k(2,3) = delta*ker(t1,t2)
k(3,1) = delta*ker(t2,t0)
k(3,2) = delta*4*ker(t2,t1)
k(3,3) = delta*ker(t2,t2)
print " hulp matrix 'k' for mat kk => "
mat print k
! 3e) build kk: from integral equation above
!a) build unit matrix
dim id(1,1)
mat redim id(nn+1,nn+1)
mat id=idn
print " result = mat kk           => "
!b) result kk matrix
mat kk = k-id
mat print kk
!4e) right hand side (rhs 'vector') of matrix kk
print " right hand side matrix 'kk' = mat rhs => "
dim rhs(1,1)
mat redim rhs(nn+1,1)
rhs(1,1)=-f(t0)
rhs(2,1)=-f(t1)
rhs(3,1)=-f(t2)
mat print rhs
!5e) solution,phi
dim phi(1,1)
mat redim phi(nn+1,1)
!a) invers matrix kk
print " inverse matrix 'kk' = mat k_inv => "
dim k_inv(1,1)
mat redim k_inv(nn+1,nn+1)
mat k_inv = inv(kk)
mat print k_inv
!b) find phi vector
print "-----------------------"
print " result : phi 'vector' "
print "-----------------------"
mat phi = k_inv*rhs
print " t0 = ";t0," => first  row phi =";phi(1,1)
print " t1 = ";t1," => second row phi =";phi(2,1)
print " t2 = ";t2," => thrid  row phi =";phi(3,1)
print
!c) example
print " delta = delta/6 "
print " xx    = ker(x,t0)*";phi(1,1);"+4*ker(x,t1)*";phi(2,1);"+ker(x,t2)*";phi(3,1)
print
print "--------------------------------"
print " result approximation phi(x) => "
print "--------------------------------"
print " phi(x) = f(x) - delta*xx "
end

function ker(x,t)
!tel = 1+x+t
!num = 2+x^2+t^2
!ratio = tel/num
ratio = x*exp(x*t)
ker=ratio
end function

function f(x)
!f=exp(-x)
f=exp(x)
end function
