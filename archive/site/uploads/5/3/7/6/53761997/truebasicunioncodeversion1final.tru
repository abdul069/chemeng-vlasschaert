!********************
! input : strings
!********************
! example
!********************
data Na,O,S,H,S
end


sub union_string(sz,A0$(),A$())
! see above : C- code
!***************************************
! rem : c-code , works only for integer
!****************************************
i0 = 0
for i =0 to sz-1
j = 0
!*****************************************
! c-code :  array index j -> j+1, i -> i+1
!*****************************************
     do while (j < i and  A0$(j+1) <> A0$(i+1))
         j = j+1
     loop
   if j >=   i then
     if i0 <> i then
!*******************************************
! c-code :  array index j -> j+1, i -> i+1 *
! i0 = i0+1 => after  A0$(i0+1) = A0$(i+1) *
!*******************************************
          i0 =i0+1 
!*******************************************
! c-code :  array index i0 -> i0+1, i -> i+1
!*******************************************
       A0$(i0+1) = A0$(i+1)        
     end if
   end if
next i
sz =i0
!*********************
! output : A$
!*********************
mat redim A$(sz+1)
for ii=0 to sz
  A$(ii+1) = A0$(ii+1)
next ii
end sub

