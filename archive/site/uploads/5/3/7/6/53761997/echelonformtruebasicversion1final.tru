option nolet
print "***************************************************"
print "* reduced echelon form 'matrix (m,n)' version 1.0 *"
print "* peter.vlasschaert@gmail.com,20/03/18            *"
print "***************************************************"
print
! filename :echelonformtruebasicversion1final.tru
!**********************************************************
rem : determinant 'square matrix' ,inverse matrix a = aa
!**********************************************************
dim a(1,1),c(1,1)
! needed for redim
input prompt " example = 1 ,input = 2 :":t
if t = 1 then
mm = 3
nn = 4
mat redim a(mm,nn),c(mm,nn)
  for i=1 to mm
    for j=1 to nn
  read a(i,j)
    next j
  next i
else
input prompt " number 'rows  ' = ":mm
input prompt " number 'column' = ":nn
mat redim a(mm,nn),c(mm,nn)
!***** < input : matrix a >*****
print "***********************"
print " input ( Matrix a ) => "
print "***********************"
print
call input_a(mm,nn,a(,),d)
end if
mat print a
!*****<change entry 'matrix a'>******
input prompt " want change an entry (Y,N) = ":yy$
if yy$ = "y" or yy$  = "Y" then 
print " enter row :i ,enter column :j  ";
input prompt "i,j = ":i,j
print " =>  new value a(";i;",";j;") = ";
input  a(i,j)
else 
 exit if
end if
print " new matrix 'a': after change value   "
mat print a
!*****< identity matrix 'c'>*****
print " identity c(";mm;",";nn;") = 'from a ' "
print
call identity_c(mm,nn,c(,))
mat print c
! main <loop reduction : matrix 'a'>
print "*************************"
print " output 'echelon matrix' "
print "*************************"
p=1 ! start : upper left 
q=1 ! init ' do while loop p,q'
!************************************
! check ' when det=determinant exit '
!************************************
if mm=nn then
 f=1 ! ' calculation inverse  : det  '
else
 f=0 ! ' no calcultion inverse: no det'
end if
do while p <= mm and q <= nn 
   cmax = 0
   k = p                ! 'pick largest
for i=p to mm           ! 'pivot in column q
  x=abs(a(i,q))
  if x > cmax then 
   cmax = x
   k = i
  end if
next i
if cmax < 1e-6 then 
f=0
d=0
q=q+1
exit do
end if
!*********************************************************
!https://en.wikipedia.org/wiki/Swap_(computer_programming)
!*********************************************************
!define swap (x, y)
!    temp := x
!    x := y
!    y := temp
!*********************************************************
for j=1 to nn
   ! swap a(p,j),a(k,j)
   temp = a(p,j)
   a(p,j)= a(k,j)
   a(k,j)=temp
  if f=1 then  
   ! swap c(p,j),c(k,j)
   temp1 = c(p,j)
   c(p,j)= c(k,j)
   c(k,j)= temp1
  end if
next j
if k > p  then d=-d
L = a(p,q)
for j=1 to nn   !' Make pivot value equal 1
  a(p,j)=a(p,j)/L
  if f=1 then c(p,j)=c(p,j)/L
next j
d=d*L
for i=1 to mm   !'kill rest of column q
  L = a(i,q)
 for j=1 to nn
  if i <> p then  
     a(i,j)=a(i,j)-L*a(p,j)
  end if
  if f=1 and i <> p then 
    c(i,j) = c(i,j)-L*c(p,j)
  end if
 next j
next i
p= p+1         ! ' On to next pivot
q= q+1         !
loop
mat print a
dim aa(1,1)
if mm=nn  then               ! square matrix
mat redim aa(nn,nn)
print " determinant      = ";d
print
!******************************************
! inverse matrix 'a' from 'square matrix'
!******************************************
! number of rows = number of columns
!******************************************
print " inverse a = a^(-1) " ! inverse matrix
print
for i=1 to nn
  for j=1 to nn
      aa(i,j) = c(i,j)
  next j
next i
end if
mat print aa
!***************************
! read-data ' matrix a '
!***************************
data 2,3,7,1
data 1,-2,-7,4
data 1,7,20,-5
!***************************
end

sub input_a(mm,nn,a(,),d)
for i=1 to mm
   for j=1 to nn
 print "a(";i;",";j;") = ";
 input a(i,j)
   next j
next i
print
d = 1 ! init value determinant
end sub

sub identity_c(mm,nn,c(,))
for i=1 to mm
   for j=1 to nn
  if i=j then 
     c(i,j)=1
       else
     c(i,j)=0
   end if
    next j
next i
end sub
  
