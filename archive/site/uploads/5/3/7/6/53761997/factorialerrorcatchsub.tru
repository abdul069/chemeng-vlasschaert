declare function factorial
print
print "*******"
print " x < 0 "
print "*******"
x=-5
print " x = ";x
call test_factorial(x)
print "*******"
print " y = 0 "
print "*******"
y=0
print " y = ";y
call test_factorial(y)
print "******"
print " u >0 "
print "******"
u=5
print " u = ";u
call test_factorial(u)
print "*******"
print " v=170 "
print "*******"
v=170
