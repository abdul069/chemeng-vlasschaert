sub random_walk(l(),k,x,y)
! How to use 'ELSE IF'
IF 1 = l(k) THEN      ! North
y = y+1
ELSE IF 2 = l(k) then ! South
y = y-1
ELSE IF 3 = l(k) then ! West
x = x-1
ELSE                  ! East
x = x+1
END IF
end sub
