option nolet
print "**************************************************"
print "* finite volume method :flow,steady 'version 1.0 *"
print "* peter.vlasschaert@gmail,29/11/2017             *"
print "**************************************************"
!***********************************************
!reactangular grid => x,y
! d/dx(u*T-tau*dT/dx)+d/dx(v*T-tau*dT/dx)=0
! flow,laminar,fully develop = u(y) and v=0 '2D'
!***********************************************
!rem :  tau = kapa/(rho*c_p)
!       T   = temperature
!       u,v = velocity
!***********************************************
print
print "************************************************"
print "* uds = upwind  difference scheme,advection    *"
print "* cds = central difference scheme,diffusion    *" 
print "************************************************"
print "* given : inlet_temperature        ,'20'       *"
print "*       : top(insulated)           ,'dt/dy=0'  *"
print "*       : bottom(-kapa*dT/dy = J_b),'10'       *"
print "************************************************"
print
!************************************
! function 'definition'
!************************************
declare function u_j,kp
!************************************
! fill interior nodes of matrix 'phi'
!************************************
l_x=0.5              ! length 'x' => lenght 'm'
print " length 'x' = ";l_x
l_y=0.1              ! length 'y' => height 'm',inlet = outlet
print " height 'y' = ";l_y
dim phi(1,1),b_b(1)  ! bb 'rhs = equations'
nu_n = 3
print " n 'x' = ";nu_n
dx = l_x/(nu_n-1)    ! grid spacing 'x'
print " dx = grid spacing 'x' = ";dx
nu_m = 4
print " m 'y' = ";nu_m
dy = l_x/(nu_m-1)    ! grid spacing 'y'
print " dy = grid spacing 'y' = ";dy
dx_dy = dx/dy        ! ratio grid spacing
dy_dx = dy/dx        ! ratio grid spacing
mat redim phi(nu_n*nu_m,nu_n*nu_m)
mat redim b_b(nu_n*nu_m)
!*********************************
! parameteric values
!*********************************
inlet_temp = 20 ! inlet temperature
print " inlet_temperature = ";inlet_temp
dens = 1000     ! density  'kg/m^3'
print " density           = ";dens
c_p  = 4200     ! specific heat capacity 'J/(kg °c)'
print " specific heat capacity = ";c_p
kapa = 0.613    ! thermal conductivity   'W/(m °c) '
print " thermal conductivity   = ";kapa
tau = kapa/(dens*c_p)
Pe_nu = 200  ! peclet number
print "global peclet number =  ";Pe_nu
print " tau = ";tau
u_avg = (Pe_nu*tau)/(dens*l_y)
j_b = 10 ! 'Watt/m^2  '
print " u_avg = ";u_avg
! mat phi = trn(phi)
print
!**********************************
! velocity profile for the flow: u_j
!**********************************
m1 = u_j(u_avg,dy,l_y,j)
!****************************
! coef 'interior cells'
!****************************
 a1= m1+2*tau*dy_dx+2*tau*dx_dy
 a2= -tau*dy_dx
 a3= -(m1+tau*dy_dx)
 a4= -tau*dx_dy
 a5= -tau*dx_dy
for i=2 to nu_n-1
   for j=2 to nu_m-1
       kk = kp(i,j,nu_n)
   phi(kk,kk) = a1
   phi(kk,kk+1) = a2
   phi(kk,kk-1) = a3
   phi(kk,kk+nu_n) = a4
   phi(kk,kk-nu_n) = a5
   next j
next i
!****************************
! coef 'inlet cells'
!****************************
 b1= m1+4*tau*dy_dx+2*tau*dx_dy
 b2= -4/3*tau*dy_dx
 b3= -tau*dx_dy
 bb= m1+8/3*tau*dy_dx
i = 1
   for j=2 to nu_m-1
       kk = kp(i,j,nu_n)
   phi(kk,kk) = b1
   phi(kk,kk+1) = b2   
   phi(kk,kk+nu_n) = b3
   phi(kk,kk-nu_n) = b3
   b_b(kk) = bb*inlet_temp
   next j
!****************************
! coef 'outlet cells'
!****************************
 c1 = m1+tau*dy_dx+2*tau*dx_dy
 c2 = -(m1+tau*dy_dx)
 c3 = -tau*dx_dy
i= nu_n
   for j=2 to nu_m-1
       kk = kp(i,j,nu_n)
   phi(kk,kk) = c1
   phi(kk,kk-1) = c2
   phi(kk,kk+nu_n) = c3
   phi(kk,kk-nu_n) = c3
   b_b(kk) = 0
   next j
!****************************
! coef 'bottom wall cells'
!****************************
 d1 = m1+2*tau*dy_dx+tau*dx_dy
 d2 = -tau*dy_dx
 d3 = -(m1+tau*dy_dx)
 d4 = -tau*dx_dy
 dd = tau*(j_b/kapa)*dx
j=1
for i=2 to nu_n-1
        kk = kp(i,j,nu_n)
   phi(kk,kk) = d1
   phi(kk,kk+1) = d2
   phi(kk,kk-1) = d3
   phi(kk,kk+nu_n) = d4   
   b_b(kk) = dd
next i
!****************************
! coef 'top wall cells'
!****************************
 e1 = m1+2*tau*dy_dx+tau*dx_dy
 e2 = -tau*dy_dx
 e3 = -(m1+tau*dy_dx)
 e4 = -tau*dx_dy
j = nu_m
for i=2 to nu_n-1
        kk = kp(i,j,nu_n)
   phi(kk,kk) = e1
   phi(kk,kk+1) = e2
   phi(kk,kk-1) = e3  
   phi(kk,kk-nu_n) = e4  
next i
!****************************
! coef 'inlet bottom corner cell'
!****************************
i=1
j=1
 f1 = m1+4*tau*dy_dx+tau*dx_dy
 f2 = -4/3*tau*dy_dx
 f3 = -tau*dx_dy
 ff = m1+8/3*tau*dy_dx
 fff = tau*(j_b/kapa)*dx
       kk = kp(i,j,nu_n)
   phi(kk,kk) = f1
   phi(kk,kk+1) = f2
   phi(kk,kk+nu_n) = f3   
   b_b(kk) = ff*inlet_temp+fff
!****************************
! coef 'inlet top corner cell'
!****************************
i=1
j=nu_m
 g1 = m1+4*tau*dy_dx+tau*dx_dy
 g2 = -4/3*tau*dy_dx
 g3 = -tau*dx_dy
 gg = m1+8/3*tau*dy_dx
      kk = kp(i,j,nu_n)
   phi(kk,kk) = g1
   phi(kk,kk+1) = g2
   phi(kk,kk-nu_n) = g3 
   b_b(kk) = gg*inlet_temp
!****************************
! coef 'outlet bottom corner cell'
!****************************
i=nu_n
j=1
h1 = m1+tau*dy_dx+tau*dx_dy
h2 = -(m1+tau*dy_dx)
h3 = -tau*dx_dy
hh = tau*(j_b/kapa)*dx
       kk = kp(i,j,nu_n)
   phi(kk,kk) = h1   
   phi(kk,kk-1) = h2
   phi(kk,kk+nu_n) = h3
   b_b(kk) = hh

!****************************
! coef 'outlet top corner cell'
!****************************
i=nu_n
j=nu_m
hh1 = m1+tau*dy_dx+tau*dx_dy
hh2 = -(m1+tau*dy_dx)
hh3 = -tau*dx_dy
       kk = kp(i,j,nu_n)
   phi(kk,kk) = hh1  
   phi(kk,kk-1) = hh2 
   phi(kk,kk-nu_n) = hh3
  
!*****************************
!*****************************
print " lhs 'equations' => "
mat print phi ! A*x=b, A=phi
print " rhs 'equations' => "
mat print b_b ! A*x=b, b=b_b
!****************************
!* => solve      ************
!****************************
!*****************************
! iteratively using ADI method
!*****************************
! only here inverse
!****************************
! 1e)=> find inverse 'phi(i,j)'
!****************************
dim phi_inv(1,1)
mat redim phi_inv(nu_n*nu_m,nu_n*nu_m)
mat phi_inv = inv(phi)
! mat print phi_inv
!***************************
!* 2e)=> bbb(nu_n*nu_m,1)  *
!***************************
dim bbb(1,1)
mat redim bbb(nu_n*nu_m,1) 
for i=1 to nu_n*nu_m
  bbb(i,1)=b_b(i)
next i
! mat print bbb
!**************************
!* 3e) sol(nu_n*nu_m,1)   *
!**************************
dim sol(1,1)
mat redim sol(nu_n*nu_m,1)
mat sol = phi_inv*bbb
print " solution => "
!mat print sol
!**************************
!* sol 'vector' to 'matrix'
!**************************
dim sol_mat(1,1)
mat redim sol_mat(nu_n,nu_m)
for i=1 to nu_n
 for j=1 to nu_m
  if i=1 then
 sol_mat(1,j) = sol(j,1)
  else if i=2  then
sol_mat(2,j) = sol(j+nu_m,1)
  else if i=3  then
sol_mat(3,j) = sol(j+2*nu_m,1)
  else 
sol_mat(4,j) = sol(j+3*nu_m,1)
  end if
 next j
next i
mat print sol_mat 
end

! => definitions

function kp(ii,jj,nu_n)
   kp=(jj-1)*nu_n+ii
end function

function u_j(u_avg,dy,l_y,j)
 r = (j*dy)/l_y
 u_j = 6*u_avg*(r-r^2)
end function

!end def
