n=8   ! input for fibonacci number
print ,str$(n) ;" the fibonacci number => "
mat redim fib(0:n)
for k = 0 to size(fib)-1
if k <= 2 then
    print "fib(";str$(k);") = "; f
    f = 1
else
    f = fib(k-1) + fib(k-2)
    print "fib(";str$(k);") = "; f
end if
   fib(k) = f
next k
