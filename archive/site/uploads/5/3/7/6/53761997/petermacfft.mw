<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">    restart:
    N := 64:
    u := Array([seq(exp(-10 + 40*i*(1 - i/N)/N), i = 1 .. N)]):
    u0 := Array([seq(4*i/N, i = 1 .. N)]):
    print(plots[pointplot]([seq([i, u[i]], i = 1 .. N)])):</Text-field>
</Input>
<Output><Text-field style="Maple Plot" layout="Maple Plot"><Plot height="500.0" type="two-dimensional" width="500.0" plot-scale="1.0" plot-xtrans="0.0" plot-ytrans="0.0" gridlinevisibility="1" legendvisibility="false"></Plot></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">    Fu := Array([seq(
        evalf(add(u[i + 1]*exp(2*I*i*j*Pi/N)/N, i = 0 .. N - 1)),
        j = 0 .. N - 1)]):
    kFu := Array(1 .. N):
    for k from 1 - N/2 to N/2 - 1 do
        if 0 &lt;= k then j := k else j := N + k end if:
        kFu[j + 1] := -2*I*Fu[j + 1]*k*Pi/N
    end do:
    kFu[N/2 + 1] := 0:
    FikFu := Array([seq(
        evalc(Re(add(kFu[i + 1]*exp(-2*I*i*j*Pi/N), i = 0 .. N - 1))),
        j = 0 .. N - 1)]):
    print(plots[pointplot]([seq([i, FikFu[i]], i = 1 .. N)])):</Text-field>
</Input>
<Output><Text-field style="Maple Plot" layout="Maple Plot"><Plot height="500.0" type="two-dimensional" width="500.0" plot-scale="1.0" plot-xtrans="0.0" plot-ytrans="0.0" gridlinevisibility="1" legendvisibility="false"></Plot></Text-field>
</Output>
</Group>
